<% cache [ book, Current.user&.id ] do %>
  <article class="deck-tile" data-deck-tile="<%= [ book.title, book.subtitle, book.author ].compact.join(" ").downcase %>">
    <%= link_to book_slug_path(book), class: "deck-tile__cover", aria: { label: book.title } do %>
      <% if book.cover.attached? %>
        <%= image_tag book.cover, alt: "" %>
      <% else %>
        <%= image_tag "empty-cover.png", alt: "", class: "deck-tile__cover-blank" %>
        <span class="deck-tile__cover-title"><%= book.title %></span>
      <% end %>
    <% end %>

    <div class="deck-tile__body">
      <h2 class="deck-tile__title"><%= link_to book.title, book_slug_path(book) %></h2>

      <p class="deck-tile__meta">
        <%= pluralize(book.leaves.size, "slide") %>
        <% if book.leaves.any? %>
          · updated <%= book.updated_at.strftime("%b %-d") %>
        <% end %>
      </p>

      <div class="deck-tile__actions">
        <% if first_leaf = book.leaves.positioned.first %>
          <%= link_to leafable_slug_path(first_leaf), class: "btn btn--small btn--primary",
                data: { action: "present#arm" } do %>
            <%= image_tag "present.svg", aria: { hidden: true }, size: 18, class: "colorize--black" %>
            <span>Present</span>
          <% end %>
        <% end %>

        <%= link_to book_slug_path(book), class: "btn btn--small" do %>
          <span>Open</span>
        <% end %>

        <% if book.editable? %>
          <%= link_to edit_book_path(book), class: "btn btn--small" do %>
            <span>Edit</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </article>
<% end %>