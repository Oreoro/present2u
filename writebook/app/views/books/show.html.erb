<% content_for(:title) { @book.title } %>
<% @layout_class = "book" %>

<% content_for :head do %>
  <%= tag.link rel: "alternate", type: "text/markdown", href: book_slug_path(@book, format: :md) %>
  <%= tag.meta property: "og:title", content: @book.title %>
  <%= tag.meta property: "og:description", content: @book.subtitle %>
  <%= tag.meta property: "og:image", content: @book.cover.blank? ? asset_url("covers/cover-#{@book.theme}-og.png") : "#{root_url}#{url_for(@book.cover)}" %>
  <%= tag.meta property: "og:url", content: book_slug_url(@book) %>

  <%= tag.meta property: "twitter:title", content: @book.title %>
  <%= tag.meta property: "twitter:description", content: @book.subtitle %>
  <%= tag.meta property: "twitter:image", content: @book.cover.blank? ? asset_url("covers/cover-#{@book.theme}-og.png") : "#{root_url}#{url_for(@book.cover)}" %>
  <%= tag.meta property: "twitter:card", content: "summary_large_image" %>
<% end %>

<% content_for :header do %>
  <nav class="book__navbar">
    <%= link_to root_path, class: "btn" do %>
      <%= image_tag "arrow-left.svg", aria: { hidden: true }, size: 24 %>
      <span class="for-screen-reader">All decks</span>
    <% end %>

    <div class="breadcrumbs">
      <%= render "books/index_link" %>
      <span class="flex-item-no-shrink">▸</span>
      <strong><%= @book.title %></strong>
    </div>

    <% if first_leaf = @leaves.first %>
      <%= link_to leafable_slug_path(first_leaf), class: "btn btn--art present-button txt-medium", data: { action: "present#arm" } do %>
        <%= image_tag "present.svg", aria: { hidden: true }, size: 24, class: "colorize--black" %>
        <span>Present</span>
      <% end %>
    <% end %>

    <% if @book.editable? %>
      <%= link_to book_publication_path(@book), class: "btn" do %>
        <%= image_tag "world.svg", aria: { hidden: true }, size: 24 %>
        <span class="for-screen-reader">Share this deck</span>
      <% end %>

      <%= link_to edit_book_path(@book), class: "btn settings" do %>
        <%= image_tag "settings.svg", aria: { hidden: true }, size: 24 %>
        <span class="for-screen-reader">Deck settings</span>
      <% end %>
    <% end %>
  </nav>
<% end %>

<% cache [ @book, @book.editable?, HtmlScrubber.cache_version ] do %>
  <header class="deck-hero">
    <div class="deck-hero__cover <%= "theme--#{@book.theme}" unless @book.cover.attached? %>">
      <% if @book.cover.attached? %>
        <%= image_tag @book.cover, alt: "" %>
      <% else %>
        <%= image_tag "empty-cover.png", alt: "", class: "deck-hero__blank" %>
        <span class="deck-hero__cover-title"><%= @book.title %></span>
      <% end %>
    </div>

    <div class="deck-hero__text">
      <h1 class="deck-hero__title"><%= @book.title %></h1>
      <% if @book.subtitle.present? %>
        <p class="deck-hero__subtitle"><%= @book.subtitle %></p>
      <% end %>
      <p class="deck-hero__meta">
        <span><%= pluralize(@leaves.size, "slide") %></span>
        <% if @book.author.present? %><span aria-hidden="true">·</span><span><%= @book.author %></span><% end %>
        <span aria-hidden="true">·</span>
        <span>updated <%= @book.updated_at.strftime("%b %-d") %></span>
        <% deck_features(@book).each do |feature, count| %>
          <span class="book__badge"><%= feature.to_s.upcase %>&nbsp;<%= count %></span>
        <% end %>
      </p>

      <div class="deck-hero__actions">
        <% if first_leaf = @leaves.first %>
          <%= link_to leafable_slug_path(first_leaf), class: "btn btn--primary", data: { action: "present#arm" } do %>
            <%= image_tag "present.svg", aria: { hidden: true }, size: 20, class: "colorize--black" %>
            <span>Present</span>
          <% end %>
        <% end %>

        <% if @book.editable? %>
          <%= link_to book_publication_path(@book), class: "btn" do %>
            <span>Share</span>
          <% end %>
          <%= link_to edit_book_path(@book), class: "btn" do %>
            <span>Settings</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </header>

  <%= arrangement_tag @book, class: "arrangement__container toc__container full-width" do %>
    <% if @book.editable? %>
      <div class="deck-toolbar">
        <span class="deck-toolbar__label">Add slide</span>
        <%= render "books/create_buttons", book: @book %>
        <span class="deck-toolbar__spacer"></span>
        <%= render "books/mode_buttons", book: @book %>
      </div>
    <% end %>

    <div class="position-relative">
      <% if @book.editable? && @leaves.empty? %>
        <div class="toc__blank-slate align-center justify-start">
          <%= image_tag "blank-slate-arrows.svg", aria: { hidden: true }, size: 60, class: "colorize--black" %>
          <span>Pick a slide type above to get started</span>
        </div>
      <% end %>

      <menu class="toc slide-grid margin-none" tabindex="0" data-arrangement-target="container" data-action="<%= arrangement_actions %>">
        <%= turbo_frame_tag :leaves, data: { arrangement_target: "list" } do -%>
          <%= render partial: "leaves/leaf", collection: @leaves, as: :leaf -%>
        <% end -%>
      </menu>

      <div data-arrangement-target="layer" class="toc"></div>
      <div data-arrangement-target="dragImage" class="arrangement-drag-image"></div>
    </div>
  <% end %>
<% end %>