{
  "name": "present2u-cloudflare",
  "private": true,
  "version": "2.0.0",
  "description": "Present2u Cloud — P2U/1 compiler at the edge, native render in a container",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "setup": "./setup.sh",
    "container:build": "docker build -t present2u-renderer container",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:create": "wrangler d1 create present2u",
    "db:migrate": "wrangler d1 migrations apply present2u --remote",
    "db:migrate:local": "wrangler d1 migrations apply present2u --local",
    "kv:create": "wrangler kv namespace create present2u-cache",
    "r2:create": "wrangler r2 bucket create present2u-blobs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.9",
    "@cloudflare/puppeteer": "^1.4.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.6.14",
    "markdown-it": "^15.0.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/markdown-it": "^14.2.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0",
    "wrangler": "^4"
  }
}
