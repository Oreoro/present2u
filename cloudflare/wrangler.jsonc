{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "present2u",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/auth/*", "/rendered/*", "/d2/*"]
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "P2U_VERSION": "1",
    "PUBLIC_ORIGIN": "https://p2u.focuslab.pk",
    "RENDER_TIMEOUT_MS": "30000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "present2u",
      "database_id": "c44f80e6-a8ab-4a2a-9df2-60e0a11f61e9",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "fbaad263589b4043b270591de6919976" }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "present2u-blobs" }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Workspace", "name": "WORKSPACE" },
      { "class_name": "RendererContainer", "name": "RENDERER" }
    ]
  },
  "containers": [
    {
      "class_name": "RendererContainer",
      "image": "./container/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "queues": {
    "producers": [{ "binding": "EXPORTS", "queue": "present2u-exports" }],
    "consumers": [{ "queue": "present2u-exports", "max_batch_size": 4 }]
  },
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Workspace"] },
    { "tag": "v2", "new_sqlite_classes": ["RendererContainer"] }
  ],
  "routes": [
    { "pattern": "p2u.focuslab.pk", "custom_domain": true }
  ]
}