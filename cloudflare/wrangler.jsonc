{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "present2u",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "p2u.focuslab.pk", "custom_domain": true }
  ]
}
